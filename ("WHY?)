local function teleportToDestination()
    if not destinationPart then return end
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    pulseButton(tpButton, Color3.fromRGB(120, 200, 255))

    local target = destinationPart.Position

    if tweenMode then
        local duration = math.clamp(15 / math.max(speedValue, 1), 0.15, 12)
        local wasAnchored = hrp.Anchored
        hrp.Anchored = true

        local currentPos = hrp.Position

        if heightValue > 0 then
            local peakPos = Vector3.new(currentPos.X, currentPos.Y + heightValue, currentPos.Z)
            local upTween = TweenService:Create(hrp, TweenInfo.new(duration * 0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                CFrame = CFrame.new(peakPos)
            })
            upTween:Play()
            upTween.Completed:Wait()
        end

        local finalTween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {
            CFrame = CFrame.new(target)
        })
        finalTween:Play()
        finalTween.Completed:Connect(function()
            hrp.Anchored = wasAnchored
        end)
    else
        local flash = Instance.new("ColorCorrectionEffect")
        flash.Brightness = 0.6
        flash.Parent = game.Lighting
        TweenService:Create(flash, TweenInfo.new(0.4), {Brightness = 0}):Play()
        task.delay(0.5, function()
            if flash and flash.Parent then flash:Destroy() end
        end)
        hrp.CFrame = CFrame.new(target)
    end
end

