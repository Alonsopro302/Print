local function getPreviewPosition()
    local mouseLoc = UIS:GetMouseLocation()
    local inset = GuiService:GetGuiInset()
    local ray = Camera:ViewportPointToRay(mouseLoc.X - inset.X, mouseLoc.Y - inset.Y)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local ex = {previewPart}
    if destinationPart then table.insert(ex, destinationPart) end
    if player.Character then table.insert(ex, player.Character) end
    params.FilterDescendantsInstances = ex
    local result = workspace:Raycast(ray.Origin, ray.Direction * 1000, params)
    if result then
        return result.Position + Vector3.new(0, 3, 0)
    end
    local char = player.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            return hrp.Position + hrp.CFrame.LookVector * 8 + Vector3.new(0, 3, 0)
        end
    end
    return nil
end

