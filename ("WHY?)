local baseColors = {}
local originalSizes = {}

local function styleButton(btn, baseColor)
    baseColors[btn] = baseColor
    originalSizes[btn] = btn.Size
    btn.AutoButtonColor = false
    btn.BorderSizePixel = 0

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 8)
    c.Parent = btn

    local s = Instance.new("UIStroke")
    s.Color = Color3.fromRGB(140, 90, 255)
    s.Thickness = 1
    s.Transparency = 0.5
    s.Parent = btn

    btn.MouseEnter:Connect(function()
        if baseColors[btn] == Color3.fromRGB(55, 35, 95) then
            TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(90, 55, 155)}):Play()
        end
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = baseColors[btn]}):Play()
    end)
    btn.MouseButton1Down:Connect(function()
        local sz = originalSizes[btn]
        TweenService:Create(btn, TweenInfo.new(0.08), {
            Size = UDim2.new(sz.X.Scale, sz.X.Offset - 6, sz.Y.Scale, sz.Y.Offset - 4)
        }):Play()
    end)
    btn.MouseButton1Up:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = originalSizes[btn]
        }):Play()
    end)
end

local function makeButton(parent, text, yPos, height, width, xPos)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(width or 1, 0, 0, height or 42)
    btn.Position = UDim2.new(xPos or 0, 0, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(55, 35, 95)
    btn.Text = text
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 15
    btn.TextColor3 = Color3.fromRGB(235, 225, 255)
    btn.Parent = parent
    styleButton(btn, Color3.fromRGB(55, 35, 95))
    return btn
end

