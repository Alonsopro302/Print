local function isAlly(plr)
    if plr == player then return true end
    if player.Team and plr.Team then
        return player.Team == plr.Team
    end
    return false
end

local function isWallBetween(targetPart)
    if not aimWallCheck then return false end
    local origin = Camera.CFrame.Position
    local dir = (targetPart.Position - origin).Unit * 500
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local ex = {}
    if player.Character then table.insert(ex, player.Character) end
    if targetPart.Parent then table.insert(ex, targetPart.Parent) end
    params.FilterDescendantsInstances = ex
    params.IgnoreWater = true
    local result = workspace:Raycast(origin, dir, params)
    if result then
        local d1 = (result.Position - origin).Magnitude
        local d2 = (targetPart.Position - origin).Magnitude
        if d1 < d2 - 1 then return true end
    end
    return false
end

local function getClosestTarget()
    local viewportSize = Camera.ViewportSize
    local center = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
    local best = nil
    local bestDist = aimFOV

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character then
            local char = plr.Character
            local hum = char:FindFirstChildOfClass("Humanoid")
            local part = char:FindFirstChild(aimPartList[aimPartIndex])
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hum and part and hrp and hum.Health > 0 then
                local valid = true
                if aimTeamCheck and isAlly(plr) then valid = false end
                if valid and isWallBetween(part) then valid = false end
                if valid then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if onScreen then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                        if dist < bestDist then
                            bestDist = dist
                            best = part
                        end
                    end
                end
            end
        end
    end
    return best
end

local function aimAtPart(part)
    if not part then return end
    local camPos = Camera.CFrame.Position
    local targetCF = CFrame.new(camPos, part.Position)
    Camera.CFrame = Camera.CFrame:Lerp(targetCF, aimSmoothness)
end

