local pDragging = false
local pMoved = false
local pDragStart
local pStartPos

pButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        pDragging = true
        pMoved = false
        pDragStart = input.Position
        pStartPos = pButton.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if pDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - pDragStart
        if math.abs(delta.X) > 4 or math.abs(delta.Y) > 4 then
            pMoved = true
        end
        pButton.Position = UDim2.new(
            pStartPos.X.Scale,
            pStartPos.X.Offset + delta.X,
            pStartPos.Y.Scale,
            pStartPos.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if pDragging then
            pDragging = false
            if not pMoved then
                isMinimized = false
                mainFrame.Visible = true
                mainScale.Scale = 0.4
                TweenService:Create(mainScale, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
                TweenService:Create(pButton, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
                    Size = UDim2.new(0, 0, 0, 0),
                    BackgroundTransparency = 1
                }):Play()
                task.delay(0.25, function()
                    pButton.Visible = false
                    pButton.BackgroundTransparency = 0
                end)
            end
        end
    end
end)

local function makeSliderDraggable(track, callback)
    local dragging = false
    local function update(input)
        local trackPos = track.AbsolutePosition.X
        local trackSize = track.AbsoluteSize.X
        local alpha = (input.Position.X - trackPos) / trackSize
        callback(alpha)
    end
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(input)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
